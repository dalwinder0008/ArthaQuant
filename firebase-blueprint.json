{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated investor profile and portfolio preferences isolated per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID matching the document ID."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Investor display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "description": "Verified Google email address."
        },
        "riskProfile": {
          "type": "string",
          "enum": ["Conservative", "Balanced", "Aggressive"],
          "description": "Investor risk tolerance preset for optimizer defaults."
        },
        "seededStarter": {
          "type": "boolean",
          "description": "Whether initial starter multi-asset holdings were seeded."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when profile was last updated."
        }
      },
      "required": ["uid", "displayName", "email", "riskProfile", "seededStarter", "createdAt", "updatedAt"]
    },
    "Holding": {
      "title": "Holding",
      "description": "Individual market holding across Equities, Gold, Crypto, REITs, or Safe Liquid ETF.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Z0-9.=\\-^]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "assetClass": {
          "type": "string",
          "enum": ["Equity", "Gold", "Crypto", "REIT", "Safe"]
        },
        "currency": {
          "type": "string",
          "enum": ["INR", "USD"]
        },
        "quantity": {
          "type": "number"
        },
        "buyPrice": {
          "type": "number"
        },
        "buyDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 240
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "ticker", "name", "assetClass", "currency", "quantity", "buyPrice", "buyDate", "createdAt", "updatedAt"]
    },
    "ManualAsset": {
      "title": "ManualAsset",
      "description": "Manually valued illiquid holding such as Real Estate or Physical Gold.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "enum": ["Residential Real Estate", "Commercial Real Estate", "Land / Plot", "Other Real Asset"]
        },
        "currentValue": {
          "type": "number"
        },
        "purchaseValue": {
          "type": "number"
        },
        "growthPct": {
          "type": "number"
        },
        "rentalYieldPct": {
          "type": "number"
        },
        "asOfDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "name", "category", "currentValue", "purchaseValue", "growthPct", "rentalYieldPct", "asOfDate", "createdAt", "updatedAt"]
    },
    "AlertRule": {
      "title": "AlertRule",
      "description": "User-configured portfolio risk, concentration, regime, or anomaly alert rule.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ruleType": {
          "type": "string",
          "enum": ["CRYPTO_WEIGHT_MAX", "ASSET_WEIGHT_MAX", "PORTFOLIO_VOL_MAX", "REGIME_BEAR", "ANOMALY_HELD", "CORRELATION_SPIKE"]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "threshold": {
          "type": "number"
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "ruleType", "target", "threshold", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated investor profile containing PII and portfolio configuration."
    },
    "/users/{userId}/holdings/{holdingId}": {
      "schema": { "$ref": "#/entities/Holding" },
      "description": "User-owned multi-asset market holdings."
    },
    "/users/{userId}/manualAssets/{assetId}": {
      "schema": { "$ref": "#/entities/ManualAsset" },
      "description": "User-owned manually valued real estate assets."
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/AlertRule" },
      "description": "User-owned portfolio alert rules."
    }
  }
}
